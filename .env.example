# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=replace-me

# SQLite database URL. The file path is relative to the working directory.
DATABASE_URL=sqlite://session_scheduler.sqlite

# Optional. During development, register commands only in this guild for faster updates.
GUILD_ID=

# Optional. Defaults to info.
RUST_LOG=session_scheduler=info,poise=info,serenity=info
